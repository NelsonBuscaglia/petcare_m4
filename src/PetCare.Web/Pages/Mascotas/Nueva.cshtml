@page
@model PetCare.Web.Pages.Mascotas.NuevaModel
@{
    ViewData["Title"] = "Registrar mascota";
}

<h1>Registrar mascota</h1>
@if (Model.Error is not null)
{
    <p class="error">@Model.Error</p>
}
<form method="post" class="formulario tarjeta">
    <label>Nombre <input name="Nombre" value="@Model.Nombre" autocomplete="off" /></label>
    <button type="submit">Registrar</button>
</form>
<p><a href="/">Volver al estado del día</a></p>
