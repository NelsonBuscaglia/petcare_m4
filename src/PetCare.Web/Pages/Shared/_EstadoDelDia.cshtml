@model PetCare.Web.Servicios.EstadoDelDia

@if (Model.SinMascotas)
{
    @* Hogar sin mascotas: se indica y se ofrece registrar una (FR-053). *@
    <div class="tarjeta">
        <p>No hay mascotas registradas en el hogar.</p>
        <a class="boton" href="/Mascotas/Nueva">Registrar una mascota</a>
    </div>
}

@foreach (var seccion in Model.Mascotas)
{
    <section class="tarjeta mascota" id="mascota-@seccion.MascotaId">
        <header>
            <h2>@seccion.Nombre</h2>
            <a href="/Mascotas/@seccion.MascotaId/Deberes">Deberes</a>
        </header>
        <ul class="lista">
            @foreach (var instancia in seccion.Instancias)
            {
                <li>
                    <span><strong>@Formato.Hora(instancia.Hora)</strong> · @Formato.Tipo(instancia.Tipo)</span>
                </li>
            }
        </ul>
    </section>
}
